config_version=5

[application]
config/name="森之刃"
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/Forest Blade — Painted Hero 2.5D"
run/main_scene="res://journey_chapter.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/description="固定镜头的林间动作冒险。"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.10,0.17,0.19,1)
anti_aliasing/quality/msaa_3d=2

[physics]
common/physics_ticks_per_second=60

[gui]
theme/custom="res://assets/fonts/game_theme.tres"
